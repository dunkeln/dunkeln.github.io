---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import SiteNav from '../components/SiteNav.astro';
import SiteHead from '../components/SiteHead.astro';

const posts = (await getCollection('writing'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const formatDate = (date: string | Date) => new Intl.DateTimeFormat('en', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
}).format(new Date(date));
const description = 'Technical writing by Prateek Pravanjan on model training, agents, observability, evaluation, and agent architecture.';
const writingJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'Writing by Prateek Pravanjan',
	description,
	url: 'https://dunkeln.github.io/writing/',
	blogPost: posts.map((post) => ({
		'@type': 'BlogPosting',
		headline: post.data.title,
		description: post.data.description,
		datePublished: post.data.date.toISOString(),
		url: `https://dunkeln.github.io/writing/${post.id}/`,
		image: new URL(post.data.cover.src, 'https://dunkeln.github.io').href,
		author: { '@id': 'https://dunkeln.github.io/#prateek-pravanjan' },
	})),
};
---

<html lang="en">
	<head>
		<SiteHead title="Writing — Prateek Pravanjan" description={description} image={posts[0]?.data.cover.src} imageAlt={posts[0]?.data.cover.alt} jsonLd={writingJsonLd} />
	</head>
	<body class="bg-canvas text-ink antialiased">
		<a class="skip-link" href="#content">Skip to content</a>

		<SiteNav current="writing" />

		<main id="content" class="mx-auto max-w-6xl px-5 pb-24 pt-32 sm:px-10 sm:pt-36" tabindex="-1">
			<section class="writing-page" aria-labelledby="writing-heading">
				<h1 id="writing-heading" class="sr-only">Writing</h1>
				<p class="writing-intro">Notes on model training, agents, observability and agent architecture.</p>
				{posts.length ? (
					<ul class="writing-list">
						{posts.map((post, index) => (
							<li>
								<a href={`/writing/${post.id}/`}>
									<div class="writing-cover">
										<img
											class:list={{ 'is-contained': post.data.cover.fit === 'contain' }}
											src={post.data.cover.src}
											alt={post.data.cover.alt}
											width={post.data.cover.width}
											height={post.data.cover.height}
											loading={index === 0 ? 'eager' : 'lazy'}
											fetchpriority={index === 0 ? 'high' : 'auto'}
										/>
									</div>
									<div class="writing-copy">
										<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="writing-empty">Nothing published here yet.</p>
				)}
			</section>
		</main>
	</body>
</html>
